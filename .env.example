# 3JN Travel OS — environment configuration example.
# Copy to ".env" and fill in. NEVER commit a real .env (it is git-ignored).
#
# The app is FAIL-CLOSED: every integration below is off until its keys are set,
# and with nothing set it runs a safe simulated flow (no real charges/tickets).
# The COMPLETE, authoritative env reference lives in docs/GO-LIVE.md (Appendix).
# This file lists the go-live essentials + the wired supplier lanes.

# Server
PORT=3000

# =====================================================================
# GO-LIVE ESSENTIALS (set all of these before flipping LIVE_MODE=true)
# =====================================================================

# Go-live switch. Removes every demo/free-AI affordance: guests get cached
# results only, all AI actions are ACU-funded, demo/admin surfaces fail closed
# unless STAFF_ACCESS_PIN is set and supplied.
LIVE_MODE=

# Staff second factor for ALL privileged access (admin/business/embassy consoles,
# staff email login, demo accounts). REQUIRED in prod — without it staff accounts
# open with no password. Use a long random value; rotate on staff change.
STAFF_ACCESS_PIN=

# HMAC secret for the human-only signup/login challenge. Set a long random string
# in production, e.g. `openssl rand -hex 32`.
HUMAN_CHECK_SECRET=

# Encryption-at-rest for PII / sensitive fields. Set random 32-byte hex values in
# production, e.g. `openssl rand -hex 32`.
DATA_ENCRYPTION_KEY=
PII_ENCRYPTION_KEY=

# Authorises the scheduled cron endpoints (/api/cron/*). Vercel Cron sends it as a
# Bearer token; without it those endpoints are open. Set a long random value.
CRON_SECRET=

# Lock CORS to your real domain(s) in production, e.g. https://3jntravel.com
CORS_ORIGIN=

# --- Payments — Stripe (card checkout + instalments; FULLY BUILT) ----------
# Set BOTH or neither. Without them, payments run in simulation (no real money).
STRIPE_SECRET_KEY=          # sk_live_...  (sk_test_... + ALLOW_TEST_PAYMENTS=true for a test run)
STRIPE_WEBHOOK_SECRET=      # whsec_...   configure the endpoint at /api/pay/stripe/webhook
# ALLOW_TEST_PAYMENTS=true  # ONLY for a sandbox dry-run; remove for production.
# Frontend publishable key (pk_live_...) goes in the frontend config, not here.

# --- Persistence (REQUIRED for go-live — else data is per-instance & lost) --
# Use EITHER Firebase RTDB OR Vercel/Upstash KV. On Cloud Run/Functions,
# Application Default Credentials activate Firebase automatically.
FIREBASE_DATABASE_URL=https://studio-1885689950-9b056-default-rtdb.europe-west1.firebasedatabase.app/
FIREBASE_SERVICE_ACCOUNT=   # the service-account JSON (or set GOOGLE_APPLICATION_CREDENTIALS)
# GOOGLE_APPLICATION_CREDENTIALS=/path/to/service-account.json
# KV_REST_API_URL=          # Vercel/Upstash KV alternative to Firebase
# KV_REST_API_TOKEN=

# --- Transactional email (Hostinger SMTP for info@3jntravel.com) -----------
# Activates when SMTP_PASS is set: booking confirmations, lead welcome, weekly
# newsletter, cheapest-date alerts. The password is a SECRET.
SMTP_HOST=smtp.hostinger.com
SMTP_PORT=465
SMTP_USER=info@3jntravel.com
SMTP_PASS=
SMTP_FROM=3JN Travel OS <info@3jntravel.com>

# --- Flights — Duffel (search + ticketing; FULLY WIRED) --------------------
# A duffel_live_... token issues real tickets; a duffel_test_... token is treated
# as OFF in LIVE_MODE (flights AND Duffel-Stays hotels then show as estimates).
DUFFEL_TOKEN=
DUFFEL_WEBHOOK_SECRET=      # REQUIRED to accept Duffel change webhooks (else ignored, fail-closed)
# DUFFEL_STAYS=false        # set false to disable Duffel Stays hotel auto-booking

# =====================================================================
# OPTIONAL LIVE SUPPLIER LANES (each independent, fail-closed)
# Turn on only what you've contracted. Booking paths marked (ops) fall to the
# ops desk until that supplier is certified. See docs/GO-LIVE.md for the rest.
# =====================================================================

# Hotels — Hotelbeds bedbank (search+book code complete; needs PROD key + mTLS).
# Defaults to the test base (50 req/day). For production set HOTELBEDS_BASE_URL
# to the live host AND provide the mTLS client cert.
HOTELBEDS_HOTEL_API_KEY=
HOTELBEDS_HOTEL_SECRET=
# HOTELBEDS_BASE_URL=https://api.hotelbeds.com
# HOTELBEDS_CLIENT_CERT=
# HOTELBEDS_CLIENT_KEY=
# HOTELBEDS_CLIENT_KEY_PASSPHRASE=

# Hotels — Amadeus (search only; booking via ops desk)
AMADEUS_CLIENT_ID=
AMADEUS_CLIENT_SECRET=

# Flights — TBO Air consolidator (search wired; ticketing via ops desk, uncertified)
TBO_AIR_CLIENT_ID=
TBO_AIR_USERNAME=
TBO_AIR_PASSWORD=
# TBO_AIR_END_USER_IP=      # a real/approved egress IP (do NOT ship the 1.1.1.1 default)

# Flights — Kiwi/Tequila LCC (search + revalidate; booking via ops desk)
TEQUILA_API_KEY=

# eSIM — Airalo (fully wired) or eSIM Access (alternative)
AIRALO_CLIENT_ID=
AIRALO_CLIENT_SECRET=
# ESIMACCESS_API_KEY=

# Activities — Viator (search live; merchant booking needs tier=merchant + cert)
VIATOR_API_KEY=
# VIATOR_PARTNER_ID=        # required or affiliate links earn nothing
# VIATOR_PARTNER_TIER=merchant

# Transfers — Mozio (search only; booking via ops desk)
MOZIO_API_KEY=

# Market fares — Travelpayouts (benchmark/calibration only; never bookable)
TRAVELPAYOUTS_TOKEN=

# Schedules — OAG (real carriers/times; no fares, priced by estimator)
OAG_SCHEDULES_KEY=
OAG_FLIGHTINFO_KEY=

# Insurance — XCover/Battleface (ROADMAP: needs a key AND FCA authorisation)
# XCOVER_API_KEY=
# INSURANCE_AUTHORISED=true

# --- AI Gateway / Model Router --------------------------------------------
# NOTE: the live-provider call in ai-gateway.js is a STUB (callProvider throws);
# every task currently runs the deterministic local engine regardless of keys.
# Setting these flips cost/labelling flags only until the SDK is wired.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
COHERE_API_KEY=
AI_GATEWAY_DEFAULT_PROVIDER=anthropic

# --- Rayna Tours B2B agent account (manual portal fulfilment by design) ----
RAYNA_PORTAL_URL=https://raynab2b.com/
RAYNA_AGENT_ID=AGT-48973
RAYNA_AGENT_EMAIL=info@3jntravel.com
RAYNA_AGENT_PASSWORD=       # SECRET — leave blank for the offline prototype
RAYNA_API_KEY=

# --- SEO / marketing verification (cosmetic) -------------------------------
# GOOGLE_SITE_VERIFICATION=
# BING_SITE_VERIFICATION=
# TRUSTPILOT_AFS_EMAIL=
# MONEY_PROTECTION_SCHEME=  # ATOL / TTA — only once genuinely certified

# NOTE: SMS_PROVIDER_KEY / PUSH_PROVIDER_KEY / WHATSAPP_PROVIDER_KEY are read by
# the comms layer but have NO send implementation yet — setting them does NOT
# send anything (those channels record 'logged', never a false 'sent').
